{
  "schema_version": 1,
  "id": "tastematch",
  "name": "TasteMatch",
  "description": "Image-dataset inspection and bounded base-SigLIP inference; training is not declared.",
  "dataset_descriptor": "tastematch.food101-index/v1",
  "runtime": {
    "protocol": "modelforge.project-runtime/v1",
    "actions": {
      "inference": {
        "kind": "executable",
        "interface": "inference_process",
        "executable": "modal_app.py",
        "result_contract": {"protocol": "modelforge.inference-result/v1"}
      }
    }
  }
}
