{
  "protocol": "modelforge.local-runtime-configuration/v1",
  "id": "bdd100k-box-head-training",
  "project_repository": "/absolute/path/to/training-project",
  "name": "BDD100K MeMOTR Box Head Training",
  "description": "20 real optimizer updates of the final MeMOTR bbox layer; frozen upstream features, separate validation, unpromoted delta.",
