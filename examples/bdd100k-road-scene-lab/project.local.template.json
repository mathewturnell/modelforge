    "checkpoint": {"id": "google-drive-3d41be3b9c10", "name": "MeMOTR BDD100K checkpoint", "path": "/absolute/path/to/memotr_bdd100k.pth", "size_bytes": 603623604, "sha256": "c90604ab0b4036d1f6b0d5ff4be7c1ea41ff581e344b234fb802b24f9d3487bd"}
  }
